# ============================================================
#  FraudShield — Environment Variables
#  Copy this file to .env and fill in your real values.
#  NEVER commit the .env file to git!
# ============================================================

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fraudshielddb
DB_USERNAME=fraudshield
DB_PASSWORD=your_strong_postgres_password_here

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_strong_redis_password_here

# ─── Kafka ────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── JWT Authentication ───────────────────────────────────────────────────────
# Generate a strong random 256-bit key, e.g.:
#   openssl rand -base64 64
JWT_SECRET=replace-with-a-strong-random-256-bit-secret-key

# ─── ML Service ───────────────────────────────────────────────────────────────
ML_SERVICE_URL=http://localhost:8000

# ─── Spring Profile ───────────────────────────────────────────────────────────
# Use 'dev' for local H2 development (no Docker required)
# Use 'prod' for full production mode (requires docker-compose up -d)
SPRING_PROFILES_ACTIVE=dev
